        {"name": "Имбирь", "key": "имбирь", "qty": 0.5, "unit": "ч. л."},
        {"name": "Соевый соус", "key": "соевый соус", "qty": 2, "unit": "ст. л."},
        {"name": "Рисовый уксус", "key": "уксус", "qty": 1, "unit": "ст. л."},
        {"name": "Оливковое масло", "key": "оливковое масло", "qty": 1, "unit": "ст. л."},
